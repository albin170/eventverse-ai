# ==============================================================================
# EventVerse AI - Environment Configuration Example
# Copy this file to .env.local for local customization.
# NEVER commit .env or secrets to source control.
# ==============================================================================

# Application Runtime Mode: "demo" | "production"
# In "demo" mode, the application uses deterministic local intelligence & local storage.
VITE_APP_MODE=demo

# Optional: Server-side AI API Endpoint (Proxied via backend / Cloud Functions)
# Do NOT store raw API keys directly in VITE_ frontend variables for production.
VITE_AI_API_ENDPOINT=http://localhost:3001/api/ai/plan

# Optional: Firebase configuration (when cloud persistence is enabled)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
